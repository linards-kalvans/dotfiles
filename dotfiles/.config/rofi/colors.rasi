* {
    background: rgba(255, 255, 255, 0.7);
    primary: #7b580c;
    primary-fixed: #ffdea8;
    primary-fixed-dim: #edc06c;
    on-primary: #ffffff;
    on-primary-fixed: #271900;
    on-primary-fixed-variant: #5e4200;
    primary-container: #ffdea8;
    on-primary-container: #271900;
    secondary: #6d5c3f;
    secondary-fixed: #f7dfbb;
    secondary-fixed-dim: #dac3a0;
    on-secondary: #ffffff;
    on-secondary-fixed: #251a04;
    on-secondary-fixed-variant: #54442a;
    secondary-container: #f7dfbb;
    on-secondary-container: #251a04;
    tertiary: #4d6544;
    tertiary-fixed: #cfebc1;
    tertiary-fixed-dim: #b3cea6;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #0b2006;
    on-tertiary-fixed-variant: #364d2e;
    tertiary-container: #cfebc1;
    on-tertiary-container: #0b2006;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fff8f3;
    on-surface: #201b13;
    on-surface-variant: #4e4639;
    outline: #807667;
    outline-variant: #d1c5b4;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #353027;
    inverse-on-surface: #faefe2;
    inverse-primary: #edc06c;
    surface-dim: #e3d8cc;
    surface-bright: #fff8f3;
    surface-container-lowest: #ffffff;
    surface-container-low: #fdf2e5;
    surface-container: #f7ecdf;
    surface-container-high: #f2e7d9;
    surface-container-highest: #ece1d4;
}
