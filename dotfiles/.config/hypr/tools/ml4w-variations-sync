#!/usr/bin/env bash
# Regenerate ~/.config/hypr/lua/variations.lua from the ML4W .conf variation
# pointer files.
#
# The ML4W Settings and Sidebar apps switch variations by rewriting one-line
# .conf files such as:
#     decoration.conf -> source = ~/.config/hypr/conf/decorations/blur.conf
# Under the Lua config those rewrites are invisible. Run this after changing a
# variation in the ML4W apps, then restart Hyprland.
set -uo pipefail

HYPR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
OUT="$HYPR/lua/variations.lua"

# Confirmed by Task 3's live probe (hypr-migration/require-semantics.md):
# dotted module path, resolved relative to the directory holding hyprland.lua.
#   require("lua.decorations.default") -> ~/.config/hypr/lua/decorations/default.lua
PREFIX="lua"
SEP="."

# pointer file : module group directory
declare -A POINTER_TO_GROUP=(
  [decoration.conf]=decorations
  [animation.conf]=animations
  [layout.conf]=layouts
  [window.conf]=windows
  [workspace.conf]=workspaces
  [keybinding.conf]=keybindings
  [windowrule.conf]=windowrules
  [environment.conf]=environments
  [monitor.conf]=monitors
)

tmp=$(mktemp)
{
  echo "-- Generated by ml4w-variations-sync on $(date -Iseconds). Do not edit."
  echo "-- Mirrors the ML4W .conf variation pointers into Lua requires."
  echo ""
} > "$tmp"

missing=0
for pointer in decoration.conf animation.conf layout.conf window.conf \
               workspace.conf keybinding.conf windowrule.conf \
               environment.conf monitor.conf; do
    group="${POINTER_TO_GROUP[$pointer]}"
    src="$HYPR/conf/$pointer"
    if [[ ! -f "$src" ]]; then
        echo "warning: $src missing, skipping" >&2
        missing=1
        continue
    fi
    # source = ~/.config/hypr/conf/decorations/blur.conf  ->  blur
    name=$(sed -nE 's|^[[:space:]]*source[[:space:]]*=.*/([^/]+)\.conf[[:space:]]*$|\1|p' "$src" | head -1)
    if [[ -z "$name" ]]; then
        echo "warning: could not parse a variation name from $src" >&2
        missing=1
        continue
    fi
    module="$HYPR/lua/$group/$name.lua"
    if [[ ! -f "$module" ]]; then
        echo "warning: $module does not exist (pointer names '$name') -- SKIPPING this group;" >&2
        echo "         its config will NOT load until the module exists. Re-run after" >&2
        echo "         converting it, or pick a variation that has been converted." >&2
        missing=1
        continue
    fi
    if [[ -n "$PREFIX" ]]; then
        echo "require(\"${PREFIX}${SEP}${group}${SEP}${name}\")" >> "$tmp"
    else
        echo "require(\"${group}${SEP}${name}\")" >> "$tmp"
    fi
done

mv "$tmp" "$OUT"
echo "wrote $OUT"
cat "$OUT"

# A missing/unresolvable pointer means a whole config section (e.g. every
# decoration directive) silently vanishes from the running config -- the
# group is skipped above, rather than emitting a require() to a nonexistent
# file, specifically so Lua's require() does not abort and take every
# subsequent require in main.lua down with it. But that skip must not be
# reported as success: the caller (ML4W app wrapper, a human, a future
# systemd unit) needs a non-zero exit to notice that a variation switch did
# not fully apply. Silent success here is exactly the "changing a variation
# does nothing" failure this bridge exists to prevent.
if [[ $missing -ne 0 ]]; then
    echo "ml4w-variations-sync: completed with WARNINGS -- see above; wrote fewer than 9 requires" >&2
    exit 1
fi
